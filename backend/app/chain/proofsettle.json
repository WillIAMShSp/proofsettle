          },
          {
            "name": "evidence",
            "type": "pubkey"
          },
          {
            "name": "index",
            "type": "u16"
          },
          {
            "name": "matches",
            "type": "bool"
          },
          {
            "name": "expected_sha256",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "recorded_sha256",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "Shipment",
      "docs": [
        "One account per shipment. Holds the agreement, the workflow state and the",
        "commitments (hashes) to everything that lives off-chain.",
        "",
        "PDA: [\"shipment\", shipment_id]  where shipment_id is the backend's 16-byte",
        "`chain_uuid` for the shipment (uuid5 of its id, e.g. \"PS-1042\")."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "shipment_id",
            "docs": [
              "UUID bytes of the off-chain shipment (backend `shipments.chain_uuid`)."
            ],
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "buyer",
            "type": "pubkey"
          },
          {
            "name": "supplier",
            "type": "pubkey"
          },
          {
            "name": "authority",
            "docs": [
              "ProofSettle backend (rules engine). Only signer of `propose_adjustment`.",
              "Cannot move funds (there are none)."
            ],
            "type": "pubkey"
          },
          {
            "name": "reviewer",
            "docs": [
              "Human reviewer. Only signer of `resolve_dispute`."
            ],
            "type": "pubkey"
          },
          {
            "name": "terms_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "invoice_amount_cents",
            "type": "u64"
          },
          {
            "name": "quantity",
            "type": "u32"
          },
          {
            "name": "credit_per_defect_cents",
            "docs": [
              "Deterministic rule, the same as the backend's settlement engine:",
              "adjustment = min(max(0, defects - defect_tolerance_units) * credit_per_defect,",
              "max_adjustment)"
            ],
            "type": "u64"
          },
          {
            "name": "max_adjustment_cents",
            "type": "u64"
          },
          {
            "name": "defect_tolerance_units",
            "type": "u32"
          },
          {
            "name": "min_dispatch_evidence",
            "docs": [
              "Photos needed before the shipment can move on (Agreed -> InTransit,",
              "InTransit -> Inspection)."
            ],
            "type": "u16"
          },
          {
            "name": "min_receipt_evidence",
            "type": "u16"
          },
          {
            "name": "buyer_approved",
            "type": "bool"
          },
          {
            "name": "supplier_approved",
            "type": "bool"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "ShipmentStatus"
              }
            }
          },
          {
            "name": "evidence_count",
            "type": "u16"
          },
          {
            "name": "dispatch_evidence_count",
            "type": "u16"
          },
          {
            "name": "receipt_evidence_count",
            "type": "u16"
          },
          {
            "name": "confirmed_defects",
            "docs": [
              "Confirmed defective units behind the current amount: the proposal's count,",
              "replaced by the reviewed count when a dispute is resolved."
            ],
            "type": "u32"
          },
          {
            "name": "findings_hash",
            "docs": [
              "sha256 of the inspection findings JSON."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "explanation_hash",
            "docs": [
              "sha256 of the settlement engine's full adjustment JSON, shown to both parties."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "proposed_adjustment_cents",
            "type": "u64"
          },
          {
            "name": "buyer_accepted",
            "docs": [
              "Both parties must accept the proposal before it becomes `Accepted`."
            ],
            "type": "bool"
          },
          {
            "name": "supplier_accepted",
            "type": "bool"
          },
          {
            "name": "dispute_reason_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "resolution_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "final_adjustment_cents",
            "type": "u64"
          },
          {
            "name": "audit_seq",
            "docs": [
              "Monotonic counter; every state-changing instruction bumps it by exactly one",
              "and emits an event carrying it, so the backend can detect missing events and",
              "tell how far its history has been mirrored on-chain."
            ],
            "type": "u64"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "updated_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ShipmentCreated",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "shipment",
            "type": "pubkey"
          },
          {
            "name": "shipment_id",
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "buyer",
            "type": "pubkey"
          },
          {
            "name": "supplier",
            "type": "pubkey"
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "reviewer",
            "type": "pubkey"
          },
          {
            "name": "terms_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "invoice_amount_cents",
            "type": "u64"
          },
          {
            "name": "seq",
            "type": "u64"
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "ShipmentDispatched",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "shipment",
            "type": "pubkey"
          },
          {
            "name": "seq",
            "type": "u64"
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "ShipmentStatus",
      "docs": [
        "Workflow from the PRD:",
        "Draft -> Agreed -> InTransit -> Inspection -> Proposed -> Accepted",
        "Proposed -> Disputed -> Resolved"
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Draft"
          },
          {
            "name": "Agreed"
          },
          {
            "name": "InTransit"
          },
          {
            "name": "Inspection"
          },
          {
            "name": "Proposed"
          },
          {
            "name": "Accepted"
          },
          {
            "name": "Disputed"
          },
          {
            "name": "Resolved"
          }
        ]
      }
    }
  ]
}